<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉框：左侧名称，右侧当前值 + 箭头，点整行弹出选项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comboRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_widget_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/comboLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/comboValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="220dp"
        android:textColor="@color/ink_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/comboChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:includeFontPadding="false"
        android:text="▾"
        android:textColor="@color/ink_disabled"
        android:textSize="14sp" />
</LinearLayout>
