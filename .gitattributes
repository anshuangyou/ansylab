# 统一行尾与二进制文件识别，避免不同平台 checkout 时出现无意义 diff。

* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell / Gradle 脚本必须是 LF，否则 Linux/macOS 下无法执行
gradlew text eol=lf
*.sh    text eol=lf

# 二进制文件：不做任何行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.onnx  binary
*.whl   binary
*.jar   binary
*.apk   binary
*.jks   binary
